{
  "name": "gloss",
  "version": "2.3.0",
  "description": "A quiet English and Devanagari PDF reader with MDX dictionaries, per-book JSON glossaries, Wiktionary, and Wikipedia lookup",
  "keywords": [
    "pdf",
    "pdf-reader",
    "pdf-viewer",
    "dictionary",
    "mdx",
    "mdict",
    "wiktionary",
    "wikipedia",
    "glossary",
    "devanagari",
    "hindi",
    "nepali",
    "sanskrit",
    "linux",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Shardhay Vatshyayan",
    "email": "88810695+shardhayv@users.noreply.github.com",
    "url": "https://github.com/shardhayv"
  },
  "homepage": "https://github.com/shardhayv/pdf-reader-with-dictionary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shardhayv/pdf-reader-with-dictionary.git"
  },
  "bugs": {
    "url": "https://github.com/shardhayv/pdf-reader-with-dictionary/issues"
  },
  "license": "AGPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.js",
    "glossary": "node scripts/make-glossary.js",
    "dictionaries": "python3 scripts/download-dictionaries.py",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --linux",
    "dist:dir": "electron-builder --linux dir",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "js-mdict": "^7.0.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "com.shardhay.gloss",
    "productName": "Gloss",
    "copyright": "Copyright © 2026 Shardhay Vatshyayan",
    "files": [
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "main.js",
      "preload.js",
      "about.html",
      "about.css",
      "about.js",
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office;Viewer",
      "synopsis": "PDF reader with instant dictionary lookup",
      "description": "Gloss is a quiet English and Devanagari PDF reader for people who read to understand. Select a word or phrase for an immediate definition from local MDX dictionaries, your own per-book JSON glossary, Wiktionary, or Wikipedia.",
      "desktop": {
        "entry": {
          "StartupWMClass": "Gloss",
          "Keywords": "pdf;reader;dictionary;mdx;wiktionary;wikipedia;glossary;devanagari;hindi;nepali;sanskrit;viewer;"
        }
      }
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "deb": {
      "afterInstall": "build/deb-after-install.sh",
      "afterRemove": "build/deb-after-remove.sh"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    }
  }
}
