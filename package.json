{
  "name": "gloss",
  "version": "2.0.0",
  "description": "A quiet PDF reader with instant Latin and Devanagari dictionary lookup",
  "author": {
    "name": "Shardhay Vatshyayan",
    "email": "watsshardhay@gmail.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --linux",
    "dist:dir": "electron-builder --linux dir",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "js-mdict": "^7.0.0",
    "pdfjs-dist": "^4.9.155"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
  },
  "build": {
    "appId": "com.shardhay.gloss",
    "productName": "Gloss",
    "copyright": "Copyright © 2026 Shardhay Vatshyayan",
    "files": [
      "main.js",
      "preload.js",
      "about.html",
      "about.css",
      "about.js",
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office;Viewer",
      "synopsis": "PDF reader with instant dictionary lookup",
      "description": "Gloss is a quiet PDF reader for people who read to understand. Select any word — in Latin or Devanagari script — and its definition appears immediately, from your own local MDX dictionaries with optional Wikipedia fallback.",
      "desktop": {
        "StartupWMClass": "Gloss",
        "Keywords": "pdf;reader;dictionary;devanagari;hindi;nepali;viewer;"
      }
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "deb": {
      "afterInstall": "build/deb-after-install.sh",
      "afterRemove": "build/deb-after-remove.sh"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    }
  }
}
